# ---------------------------------------------------------------------------
# Copy this file to `.env` at the repository root and adjust the values.
# Every service (Next.js app, Python worker, Docker Compose) reads from it.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Next.js -----------------------------------------------------------------
# Base URL the browser uses to reach the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret required by POST /api/jobs/[name]/trigger.
# Generate one with: openssl rand -hex 32
CRON_SECRET=dev-secret-change-me

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=lasce
POSTGRES_PASSWORD=lasce
POSTGRES_DB=lasce
# Used by Prisma (Next.js) and SQLAlchemy (worker).
DATABASE_URL=postgresql://lasce:lasce@localhost:5432/lasce

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Name of the BullMQ queue shared by the producer (TS) and consumer (Python).
QUEUE_NAME=lasce

# --- InfluxDB 3 Core ---------------------------------------------------------
INFLUXDB_HOST=http://localhost:8181
INFLUXDB_TOKEN=dev-influx-token-change-me
INFLUXDB_DATABASE=lasce

# --- MinIO (S3-compatible object storage) ------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=lasce
MINIO_SECRET_KEY=lasce-secret
MINIO_BUCKET=lasce-files
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=lasce-files

# --- Worker ------------------------------------------------------------------
# How many jobs a single worker process handles concurrently.
WORKER_CONCURRENCY=4
LOG_LEVEL=info
