model GeomagneticIndexTranslation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  geomagneticIndexId String   @map("geomagnetic_index_id") @db.Uuid
  locale             String   @db.VarChar(5)
  description        String   @db.VarChar(15)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  geomagneticIndex GeomagneticIndex @relation(fields: [geomagneticIndexId], references: [id], onDelete: Cascade)

  @@unique([geomagneticIndexId, locale])
  @@map("geomagnetic_index_translations")
  @@schema("public")
}

