/// One file a signed-in user downloaded from `/datos`: a chart image or a data export. Written
/// by `apps/web/app/services/downloads/downloadService.ts` only after the object reached the
/// private downloads bucket, so every row names an object that existed. The object itself
/// expires (bucket lifecycle); this row is the permanent record. The worker never writes here.
model ResourceDownload {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null once the account is deleted, so the audit trail outlives it.
  userId     String?  @map("user_id") @db.Uuid
  /// Codes from the catalogue in `apps/web/app/lib/scientific-data.ts`, e.g. "GOES" / "EXIS" /
  /// "SFXR". Plain strings, like `RolePermission.permission`, so a new instrument needs no migration.
  source     String
  instrument String
  product    String
  /// A code from `DOWNLOAD_FORMATS` in `apps/web/app/lib/downloads/formats.ts`, e.g. "csv".
  format     String
  /// The query that produced the file: `parameter`, `date`, `startTime`, `endTime`.
  params     Json
  /// Key inside `MINIO_DOWNLOADS_BUCKET`.
  objectKey  String   @map("object_key")
  byteSize   Int      @map("byte_size")
  /// Data rows exported; null for images.
  rowCount   Int?     @map("row_count")
  /// When the presigned link handed to the user stops working.
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([source, instrument, createdAt])
  @@map("resource_downloads")
  @@schema("public")
}

/// One thing that happened in the portal, for the "Actividad reciente" panel of
/// `/administracion` and any later audit view (LASCE-CON-012-151). Append-only: a row is never
/// updated, and it is written through `apps/web/app/lib/audit-log.ts`. Only the web writes here;
/// the worker does not mirror this table.
model AuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What happened, as `<entity>.<verb>`, e.g. "publication.create". A plain string, like
  /// `RolePermission.permission`, so a new kind of event needs no migration.
  action     String
  /// The line the panel shows, written when the event happens so it still reads after the entity
  /// it names is gone, e.g. "Publicación agregada: Solar flares in 2026".
  summary    String
  /// "user", "system" or "worker"; see `AUDIT_ACTOR_TYPES` in `audit-log.ts`.
  actorType  String   @map("actor_type")
  /// The account that acted. Null for the system, or once the account is deleted, so the trail
  /// outlives it.
  actorId    String?  @map("actor_id") @db.Uuid
  /// What was acted on, e.g. "publication" and its id. Null when there is no single target.
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  /// Anything else worth keeping about the event, e.g. the fields that changed.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
  @@schema("public")
}

