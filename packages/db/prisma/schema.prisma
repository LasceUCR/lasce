// PostgreSQL schema for lasce.
//
// This file is the single source of truth for the relational schema. Prisma owns
// the migrations; the Python worker reads and writes the same tables through
// SQLAlchemy (see apps/worker/app/db/models.py) but never migrates them.
//
// After changing a model: `pnpm db:migrate` and update the SQLAlchemy mirror.
//
// Two deliberate choices that exist because a second language writes here:
//   - ids default to `gen_random_uuid()` in PostgreSQL rather than Prisma's
//     `cuid()`, which is generated client-side and would leave the worker with
//     no way to insert a row.
//   - `@updatedAt` is also client-side, so every column using it carries a
//     `@default(now())` and the worker sets it explicitly when it updates a row.
//   - timestamps are `timestamptz`, not Prisma's default `timestamp`, so both
//     languages exchange timezone-aware values instead of ambiguous naive ones.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts `url` here: the migration engine reads it from
  // prisma.config.ts, and PrismaClient gets it through the driver adapter in
  // src/index.ts.

  // One Postgres schema per domain. `public` stays declared for whatever
  // non-domain-specific table comes next.
  schemas = ["public", "research", "news", "auth", "gallery", "solar", "areas"]
}

/// Access level of a portal account. Self-registration always yields `visitor`;
/// `assistant` and `admin` are granted by an administrator (LASCE-ADM #80). What
/// each role may do lives in `RolePermission` (LASCE-SEC-008-073), not here.
enum UserRole {
  VISITOR   @map("visitor")
  ASSISTANT @map("assistant")
  ADMIN     @map("admin")

  @@map("user_role")
  @@schema("auth")
}

/// A portal account created through the public registration form at `/registro`
/// (LASCE-SEC-008-071). Browser sessions live in `Session`, never in columns here.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String    @map("full_name")
  /// Trimmed and lower-cased by the application before every write and lookup,
  /// so the unique index is case-insensitive without a citext extension.
  email        String    @unique
  institution  String
  /// ISO 3166-1 alpha-2 code, e.g. "CR". Display names are derived at render time.
  countryCode  String    @map("country_code") @db.Char(2)
  /// Self-describing KDF string, `scrypt$<N>$<r>$<p>$<salt>$<hash>`. Produced and
  /// verified by apps/web/app/lib/auth/password.ts.
  passwordHash String    @map("password_hash")
  /// Registration uses the default; administrators can replace or remove the assignment.
  role         UserRole? @default(VISITOR)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  resourceDownloads   ResourceDownload[]
  nosotrosActivities  NosotrosActivity[]
  researchers         Researcher[]
  nosotrosResearchers NosotrosResearcher[]
  auditEvents         AuditEvent[]

  @@map("users")
  @@schema("auth")
}

/// A browser session for a portal account (LASCE-SEC-008-072). The cookie holds a
/// random token and only its SHA-256 is stored, so reading this table yields
/// nothing a browser could present. Deleting the row revokes the session at once;
/// expiry is absolute (30 days from login). The worker never writes here.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// base64url SHA-256 of the `lasce_session` cookie value. Never the token itself.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("auth")
}

/// Permission granted to a `UserRole`. The permission strings themselves are
/// the TypeScript catalogue in `apps/web/app/lib/auth/permissions.ts`; this
/// table only stores the mapping so administrators can change it without a
/// deploy of unrelated features (LASCE-SEC-008-073).
model RolePermission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role       UserRole
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([role, permission])
  @@map("role_permissions")
  @@schema("auth")
}

/// A journal, conference, or institutional outlet a research record was
/// published through — the "venue" shown on the public research page.
model Publisher {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  researchRecords Research[]

  @@map("publishers")
  @@schema("research")
}

enum ResearchGroup {
  LASCE
  ROSAC

  @@schema("research")
}

/// A public research record shown on `/investigacion`: a paper, article, or
/// institutional note, linked to its original source rather than a hosted
/// copy. Mapped to `research_records` rather than `research` to avoid the
/// `research.research` stutter under the `research` Postgres schema.
model Research {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  publicationDate DateTime      @map("publication_date") @db.Date
  publisherId     String        @map("publisher_id") @db.Uuid
  researchGroup   ResearchGroup @map("research_group")
  abstract        String        @db.Text
  /// Publications might not have a url.
  externalUrl     String?       @unique @map("external_url")
  /// Digital Object Identifier, e.g. "10.1007/s11207-015-0677-0". Optional —
  /// not every record (institutional notes) has one — but unique when present.
  doi             String?       @unique
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  publisher    Publisher             @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  authors      ResearchCrossAuthor[]
  translations ResearchTranslation[]

  @@index([publicationDate])
  @@index([researchGroup])
  @@map("research_records")
  @@schema("research")
}

/// The translatable text of a `Research` record in a language other than the
/// source one (see "Dynamic content" in docs/internationalization.md). The base row keeps
/// the source-language `title` and `abstract`; this table holds one row per
/// additional locale. Only `title` and `abstract` are translated: publishers and
/// authors are proper nouns.
///
/// `locale` is a plain string validated against `locales` in apps/web, so adding a
/// language needs no migration. A record created before translations existed has
/// no row here, and its base text is in whatever language it was entered in.
model ResearchTranslation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId String   @map("research_id") @db.Uuid
  locale     String   @db.VarChar(5)
  title      String
  abstract   String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  research Research @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@unique([researchId, locale])
  @@map("research_record_translations")
  @@schema("research")
}

/// A person credited as an author on one or more research records.
model ResearchAuthor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique so the same person is reused across records rather than duplicated.
  /// Two distinct people who happen to share a citation form (e.g. two
  /// "J. García"s) would collide under this — acceptable at today's scale, but
  /// worth revisiting (an external id, ORCID, ...) if it becomes a real problem.
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  researchRecords ResearchCrossAuthor[]

  @@map("research_authors")
  @@schema("research")
}

enum CollaborationScope {
  NATIONAL      @map("national")
  INTERNATIONAL @map("international")

  @@map("collaboration_scope")
  @@schema("research")
}

/// Partner organizations shown on `/colaboraciones-e-iniciativas`. Official names,
/// acronyms, classification and display order are shared across languages.
model Collaboration {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  acronym    String?
  country    String
  websiteUrl String?            @map("website_url")
  logoPath   String?            @map("logo_path")
  scope      CollaborationScope
  position   Int                @default(0)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations CollaborationTranslation[]

  @@map("collaborations")
  @@schema("research")
}

/// Country is currently the only editable translatable field of a collaboration.
/// Spanish stays on the base row; other locales follow the shared content resolver.
model CollaborationTranslation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collaborationId String   @map("collaboration_id") @db.Uuid
  locale          String   @db.VarChar(5)
  country         String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, locale])
  @@map("collaboration_translations")
  @@schema("research")
}

/// Many-to-many join between `Research` and `ResearchAuthor`. Keeps `position`
/// so a record's citation order (first author, second author, ...) can be
/// reproduced on the public page instead of coming back in arbitrary order.
model ResearchCrossAuthor {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId       String @map("research_id") @db.Uuid
  researchAuthorId String @map("research_author_id") @db.Uuid
  position         Int

  research       Research       @relation(fields: [researchId], references: [id], onDelete: Cascade)
  researchAuthor ResearchAuthor @relation(fields: [researchAuthorId], references: [id], onDelete: Cascade)

  @@unique([researchId, researchAuthorId])
  @@index([researchId, position])
  @@map("research_cross_authors")
  @@schema("research")
}

/// An outlet where a news item was published.
model NewsSource {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  newsRecords News[]

  @@map("news_sources")
  @@schema("news")
}

/// A public news item shown on `/noticias`: a media article, institutional note,
/// or external coverage item linked to its source.
model News {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  publishedAt DateTime? @map("published_at") @db.Date
  sourceId    String    @map("source_id") @db.Uuid
  abstract    String    @db.Text
  externalUrl String    @unique @map("external_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  source       NewsSource        @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  authors      NewsCrossAuthor[]
  translations NewsTranslation[]

  @@index([publishedAt])
  @@map("news_records")
  @@schema("news")
}

/// The translatable text of a `News` item in a language other than the source one
/// (see docs/translate-database-content.md). The base row keeps the source-language
/// `title` and `abstract`; this table holds one row per additional locale. Sources,
/// authors, dates and links are shared by every language.
///
/// `locale` is a plain string validated against `locales` in apps/web, so adding a
/// language needs no migration. An item created before translations existed has no
/// row here, and its base text is in whatever language it was entered in.
model NewsTranslation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId    String   @map("news_id") @db.Uuid
  locale    String   @db.VarChar(5)
  title     String
  abstract  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@map("news_record_translations")
  @@schema("news")
}

/// A person credited as an author on one or more news items.
model NewsAuthor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  newsRecords NewsCrossAuthor[]

  @@map("news_authors")
  @@schema("news")
}

/// Many-to-many join between `News` and `NewsAuthor`. Keeps `position` so a
/// record's citation order can be reproduced on the public page.
model NewsCrossAuthor {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId       String @map("news_id") @db.Uuid
  newsAuthorId String @map("news_author_id") @db.Uuid
  position     Int

  news       News       @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsAuthor NewsAuthor @relation(fields: [newsAuthorId], references: [id], onDelete: Cascade)

  @@unique([newsId, newsAuthorId])
  @@index([newsId, position])
  @@map("news_cross_authors")
  @@schema("news")
}

/// A "¿Qué hacemos?" flashcard on the Nosotros page (LASCE-CON-012-086). One row
/// per card — icon, title and paragraph are the three editable fields; the rest
/// is audit metadata (who changed it last, and when).
enum NosotrosActivityIcon {
  SUN           @map("sun")
  WAVES         @map("waves")
  SATELLITE     @map("satellite")
  CODE          @map("code")
  COLLABORATION @map("collaboration")
  EDUCATION     @map("education")

  @@map("nosotros_activity_icon")
  @@schema("public")
}

model NosotrosActivity {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  icon       NosotrosActivityIcon
  title      String
  paragraph  String               @db.Text
  /// Display order. Set once at creation and never touched by an edit, so
  /// saving a card's text doesn't also reorder it — `modifiedAt` alone can't
  /// serve as the sort key because editing changes it on purpose.
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  modifiedBy String               @map("modified_by") @db.Uuid
  modifiedAt DateTime             @default(now()) @updatedAt @map("modified_at") @db.Timestamptz(3)

  modifier     User                          @relation(fields: [modifiedBy], references: [id], onDelete: Restrict)
  translations NosotrosActivityTranslation[]

  @@map("nosotros_activities")
  @@schema("public")
}

/// The translatable text of a `NosotrosActivity` in a language other than the
/// source one (see "Dynamic content" in docs/internationalization.md). The base
/// row keeps the source-language `title` and `paragraph`; this table holds one row
/// per additional locale. `icon` is shared and stays on the base row.
///
/// `locale` is a plain string validated against `locales` in apps/web, so adding a
/// language needs no migration. A card created before translations existed has no
/// row here, and its base text is in whatever language it was entered in.
model NosotrosActivityTranslation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  locale     String   @db.VarChar(5)
  title      String
  paragraph  String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity NosotrosActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, locale])
  @@map("nosotros_activity_translations")
  @@schema("public")
}

/// An editable text section of the solar physics page (`/fisica-solar`). Today there is one
/// row, with `key` `lasce` ("El trabajo de LASCE en Física Solar"); `key` is unique so the page
/// can look the section up and a second section can be added without a new table.
/// `title` and `body` are the Spanish source text; every other language lives in
/// `SolarPhysicsSectionTranslation`. `body` is plain text: a blank line separates paragraphs.
model SolarPhysicsSection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Also the version an editor saves against (optimistic concurrency).
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations SolarPhysicsSectionTranslation[]

  @@map("solar_physics_sections")
  @@schema("public")
}

/// The `title` and `body` of a `SolarPhysicsSection` in a language other than the source one.
/// One row per (section, locale); `locale` is a short string validated by the app, so a new
/// language needs no migration.
model SolarPhysicsSectionTranslation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  locale    String   @db.VarChar(5)
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  section SolarPhysicsSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("solar_physics_section_translations")
  @@schema("public")
}

/// One SUVI L1b frame, catalogued from its FITS header. Written by the Python
/// worker (apps/worker/app/services/process_headers.py), never by the web app.
/// Photometric and CCD-health numbers are NOT here — they go to InfluxDB.
model SuviFrame {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// FITS `DATE-OBS`, the official instant of the exposure.
  observedAt   DateTime @map("observed_at") @db.Timestamptz(3)
  /// FITS `WAVELNTH`, in angstroms.
  wavelength   Float    @db.DoublePrecision
  /// FITS `TELESCOP`, e.g. "G19".
  satellite    String
  /// Archive channel token, e.g. "Fe093". From the file name, not the header.
  channel      String
  fileName     String   @unique @map("file_name")
  sourceUrl    String   @map("source_url")
  /// FITS `EXPTIME`, seconds.
  exposureTime Float?   @map("exposure_time") @db.DoublePrecision
  /// FITS `CRPIX1`/`CRPIX2`: the Sun's centre in the 1280x1280 matrix.
  sunCenterX   Float?   @map("sun_center_x") @db.DoublePrecision
  sunCenterY   Float?   @map("sun_center_y") @db.DoublePrecision
  /// FITS `RSUN`, solar radius in pixels. Needed to recompute the background mask.
  sunRadiusPx  Float?   @map("sun_radius_px") @db.DoublePrecision
  /// Bitfield: bit 0 = `CONT_FLG`, bit 1 = `ECLIPSE`. 0 means a clean capture.
  qualityFlag  Int      @default(0) @map("quality_flag")
  /// The whole FITS header, so a field not promoted to a column is still recoverable.
  rawHeader    Json     @map("raw_header")
  /// MinIO key of this frame's rendered PNG (illustrative only, not a scientific product).
  /// Written by app.services.suvi_preview.publish_preview. Null only for a frame whose FITS HDU
  /// carried no data array.
  previewFile  String?  @map("preview_file")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([satellite, channel, observedAt])
  @@index([observedAt])
  @@map("suvi_frames")
  @@schema("solar")
}

/// One daily EXIS L1b file (one product, one UTC day) whose readings are in InfluxDB.
/// Written only by the worker's `exis-pipeline` job; the readings themselves live in the
/// `exis_irradiance` InfluxDB measurement, not here.
model ExisFile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NetCDF `platform_ID`, e.g. "G19".
  satellite        String
  /// "SFEU" or "SFXR".
  product          String
  /// The UTC day the file covers, from its name.
  day              DateTime  @db.Date
  fileName         String    @unique @map("file_name")
  /// The `_vX-Y-Z` part of the file name, e.g. "0-0-0".
  version          String
  sourceUrl        String    @map("source_url")
  /// The archive's `Last-Modified` when ingested. A newer one means NOAA republished the day.
  sourceModifiedAt DateTime? @map("source_modified_at") @db.Timestamptz(3)
  firstObservedAt  DateTime? @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt   DateTime? @map("last_observed_at") @db.Timestamptz(3)
  /// Points written to InfluxDB per channel code, e.g. {"0.1-0.8nm": 86112}.
  pointCount       Json      @map("point_count")
  /// The NetCDF global attributes, so provenance not promoted to a column is still recoverable.
  attributes       Json
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([satellite, product, day])
  @@map("exis_files")
  @@schema("solar")
}

/// One daily MAG L2 1-minute geomagnetic field file (one UTC day) whose readings are in InfluxDB.
/// Written only by the worker's `mag-pipeline` job; the readings themselves live in the
/// `mag_field` InfluxDB measurement, not here.
model MagFile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The NetCDF `platform` attribute, upper-cased, e.g. "G19".
  satellite        String
  /// Always "GEOF", the catalogue code of the geomagnetic field product.
  product          String
  /// The UTC day the file covers, from its name.
  day              DateTime  @db.Date
  fileName         String    @unique @map("file_name")
  /// The `_vX-Y-Z` part of the file name, e.g. "2-0-4".
  version          String
  sourceUrl        String    @map("source_url")
  /// The archive's `Last-Modified` when ingested. A newer one means NOAA republished the day.
  sourceModifiedAt DateTime? @map("source_modified_at") @db.Timestamptz(3)
  firstObservedAt  DateTime? @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt   DateTime? @map("last_observed_at") @db.Timestamptz(3)
  /// Points written to InfluxDB per channel code, e.g. {"total": 1440}.
  pointCount       Json      @map("point_count")
  /// The NetCDF global attributes, so provenance not promoted to a column is still recoverable.
  attributes       Json
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([satellite, product, day])
  @@map("mag_files")
  @@schema("solar")
}

/// One daily SEISS file (one product, one UTC day) whose readings are in InfluxDB.
/// Written only by the worker's `seiss-pipeline` job; the readings themselves live in the
/// product's InfluxDB measurement (`ehis_flux`, `sgps_flux`), not here.
model SeissFile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The spacecraft, e.g. "G19" (EHIS reads `platform_ID`, the L2 products `platform`).
  satellite        String
  /// The SEISS product code: "EHIS" or "SGPS".
  product          String
  /// The UTC day the file covers, from its name.
  day              DateTime  @db.Date
  fileName         String    @unique @map("file_name")
  /// The `_vX-Y-Z` part of the file name, e.g. "0-0-2".
  version          String
  sourceUrl        String    @map("source_url")
  /// The archive's `Last-Modified` when ingested. A newer one means NOAA republished the day.
  sourceModifiedAt DateTime? @map("source_modified_at") @db.Timestamptz(3)
  firstObservedAt  DateTime? @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt   DateTime? @map("last_observed_at") @db.Timestamptz(3)
  /// Points written to InfluxDB per channel code, e.g. {"H:E1": 288} or {"plus:P1": 1440}.
