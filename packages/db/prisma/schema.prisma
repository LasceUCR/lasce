// PostgreSQL schema for lasce.
//
// This file is the single source of truth for the relational schema. Prisma owns
// the migrations; the Python worker reads and writes the same tables through
// SQLAlchemy (see apps/worker/app/db/models.py) but never migrates them.
//
// After changing a model: `pnpm db:migrate` and update the SQLAlchemy mirror.
//
// Two deliberate choices that exist because a second language writes here:
//   - ids default to `gen_random_uuid()` in PostgreSQL rather than Prisma's
//     `cuid()`, which is generated client-side and would leave the worker with
//     no way to insert a row.
//   - `@updatedAt` is also client-side, so every column using it carries a
//     `@default(now())` and the worker sets it explicitly when it updates a row.
//   - timestamps are `timestamptz`, not Prisma's default `timestamp`, so both
//     languages exchange timezone-aware values instead of ambiguous naive ones.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  // Prisma 7 no longer accepts `url` here: the migration engine reads it from
  // prisma.config.ts, and PrismaClient gets it through the driver adapter in
  // src/index.ts.

  // One Postgres schema per domain. `public` stays declared for whatever
  // non-domain-specific table comes next.
  schemas = ["public", "research", "news", "auth"]
}

/// Access level of a portal account. Self-registration always yields `visitor`;
/// `assistant` and `admin` are granted by an administrator (LASCE-ADM #80). What
/// each role may do lives in `RolePermission` (LASCE-SEC-008-073), not here.
enum UserRole {
  VISITOR   @map("visitor")
  ASSISTANT @map("assistant")
  ADMIN     @map("admin")

  @@map("user_role")
  @@schema("auth")
}

/// A portal account created through the public registration form at `/registro`
/// (LASCE-SEC-008-071). Browser sessions live in `Session`, never in columns here.
model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name")
  /// Trimmed and lower-cased by the application before every write and lookup,
  /// so the unique index is case-insensitive without a citext extension.
  email        String   @unique
  institution  String
  /// ISO 3166-1 alpha-2 code, e.g. "CR". Display names are derived at render time.
  countryCode  String   @map("country_code") @db.Char(2)
  /// Self-describing KDF string, `scrypt$<N>$<r>$<p>$<salt>$<hash>`. Produced and
  /// verified by apps/web/app/lib/auth/password.ts.
  passwordHash String   @map("password_hash")
  /// Registration uses the default; administrators can replace or remove the assignment.
  role         UserRole? @default(VISITOR)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  sessions Session[]
  nosotrosActivities NosotrosActivity[]
  researchers Researcher[]

  @@map("users")
  @@schema("auth")
}

/// A browser session for a portal account (LASCE-SEC-008-072). The cookie holds a
/// random token and only its SHA-256 is stored, so reading this table yields
/// nothing a browser could present. Deleting the row revokes the session at once;
/// expiry is absolute (30 days from login). The worker never writes here.
model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// base64url SHA-256 of the `lasce_session` cookie value. Never the token itself.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("auth")
}

/// Permission granted to a `UserRole`. The permission strings themselves are
/// the TypeScript catalogue in `apps/web/app/lib/auth/permissions.ts`; this
/// table only stores the mapping so administrators can change it without a
/// deploy of unrelated features (LASCE-SEC-008-073).
model RolePermission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role       UserRole
  permission String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([role, permission])
  @@map("role_permissions")
  @@schema("auth")
}

/// A journal, conference, or institutional outlet a research record was
/// published through — the "venue" shown on the public research page.
model Publisher {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  researchRecords Research[]

  @@map("publishers")
  @@schema("research")
}

enum ResearchGroup {
  LASCE
  ROSAC

  @@schema("research")
}

/// A public research record shown on `/investigacion`: a paper, article, or
/// institutional note, linked to its original source rather than a hosted
/// copy. Mapped to `research_records` rather than `research` to avoid the
/// `research.research` stutter under the `research` Postgres schema.
model Research {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  publicationDate DateTime      @map("publication_date") @db.Date
  publisherId     String        @map("publisher_id") @db.Uuid
  researchGroup   ResearchGroup @map("research_group")
  abstract        String        @db.Text
  /// Link to the original source. Unique so the same paper can't be listed twice.
  externalUrl     String        @unique @map("external_url")
  /// Digital Object Identifier, e.g. "10.1007/s11207-015-0677-0". Optional —
  /// not every record (institutional notes) has one — but unique when present.
  doi             String?       @unique
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  publisher Publisher           @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  authors   ResearchCrossAuthor[]

  @@index([publicationDate])
  @@index([researchGroup])
  @@map("research_records")
  @@schema("research")
}

/// A person credited as an author on one or more research records.
model ResearchAuthor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique so the same person is reused across records rather than duplicated.
  /// Two distinct people who happen to share a citation form (e.g. two
  /// "J. García"s) would collide under this — acceptable at today's scale, but
  /// worth revisiting (an external id, ORCID, ...) if it becomes a real problem.
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  researchRecords ResearchCrossAuthor[]

  @@map("research_authors")
  @@schema("research")
}

/// Many-to-many join between `Research` and `ResearchAuthor`. Keeps `position`
/// so a record's citation order (first author, second author, ...) can be
/// reproduced on the public page instead of coming back in arbitrary order.
model ResearchCrossAuthor {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  researchId       String @map("research_id") @db.Uuid
  researchAuthorId String @map("research_author_id") @db.Uuid
  position         Int

  research       Research       @relation(fields: [researchId], references: [id], onDelete: Cascade)
  researchAuthor ResearchAuthor @relation(fields: [researchAuthorId], references: [id], onDelete: Cascade)

  @@unique([researchId, researchAuthorId])
  @@index([researchId, position])
  @@map("research_cross_authors")
  @@schema("research")
}

/// An outlet where a news item was published.
model NewsSource {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  newsRecords News[]

  @@map("news_sources")
  @@schema("news")
}

/// A public news item shown on `/noticias`: a media article, institutional note,
/// or external coverage item linked to its source.
model News {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  publishedAt DateTime?  @map("published_at") @db.Date
  sourceId    String     @map("source_id") @db.Uuid
  abstract    String     @db.Text
  externalUrl String     @unique @map("external_url")
  imageUrl    String     @map("image_url")
  imageAlt    String     @map("image_alt")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  source      NewsSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  authors     NewsCrossAuthor[]

  @@index([publishedAt])
  @@map("news_records")
  @@schema("news")
}

/// A person credited as an author on one or more news items.
model NewsAuthor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @default(now()) @map("updated_at") @db.Timestamptz(3)

  newsRecords NewsCrossAuthor[]

  @@map("news_authors")
  @@schema("news")
}

/// Many-to-many join between `News` and `NewsAuthor`. Keeps `position` so a
/// record's citation order can be reproduced on the public page.
model NewsCrossAuthor {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId       String     @map("news_id") @db.Uuid
  newsAuthorId String     @map("news_author_id") @db.Uuid
  position     Int

  news         News       @relation(fields: [newsId], references: [id], onDelete: Cascade)
  newsAuthor   NewsAuthor @relation(fields: [newsAuthorId], references: [id], onDelete: Cascade)

  @@unique([newsId, newsAuthorId])
  @@index([newsId, position])
  @@map("news_cross_authors")
  @@schema("news")
}

/// A "¿Qué hacemos?" flashcard on the Nosotros page (LASCE-CON-012-086). One row
/// per card — icon, title and paragraph are the three editable fields; the rest
/// is audit metadata (who changed it last, and when).
enum NosotrosActivityIcon {
  SUN           @map("sun")
  WAVES         @map("waves")
  SATELLITE     @map("satellite")
  CODE          @map("code")
  COLLABORATION @map("collaboration")
  EDUCATION     @map("education")

  @@map("nosotros_activity_icon")
  @@schema("public")
}

model NosotrosActivity {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  icon        NosotrosActivityIcon
  title       String
  paragraph   String               @db.Text
  /// Display order. Set once at creation and never touched by an edit, so
  /// saving a card's text doesn't also reorder it — `modifiedAt` alone can't
  /// serve as the sort key because editing changes it on purpose.
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  modifiedBy  String               @map("modified_by") @db.Uuid
  modifiedAt  DateTime             @updatedAt @default(now()) @map("modified_at") @db.Timestamptz(3)

  modifier User @relation(fields: [modifiedBy], references: [id], onDelete: Restrict)

  @@map("nosotros_activities")
  @@schema("public")
}

/// A researcher profile card shown on `/radioastronomia` (LASCE-CON-012-085).
/// Distinct from `research.ResearchAuthor`: that one is only a citation name
/// on a publication, this is the full public bio card — photo, role,
/// institution, optional email, description.
model Researcher {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Local path under `apps/web/public`, same convention `TeamMember.src` uses
  /// today. Revisit once photo upload has a real storage-backed URL.
  photoUrl    String   @map("photo_url")
  role        String
  name        String
  institution String
  /// Public address, rendered as a `mailto:` link. Not every researcher has one.
  email       String?
  description String   @db.Text
  /// Display order. Set once at creation and never touched by an edit — same
  /// reasoning as `NosotrosActivity.createdAt`.
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  modifiedBy  String   @map("modified_by") @db.Uuid
  modifiedAt  DateTime @updatedAt @default(now()) @map("modified_at") @db.Timestamptz(3)

  modifier User @relation(fields: [modifiedBy], references: [id], onDelete: Restrict)

  @@map("researchers")
  @@schema("public")
}

