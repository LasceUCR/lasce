  AUTOMATIC @map("automatic")

  @@map("geomagnetic_index_source")
  @@schema("public")
}

/// One geomagnetic index card on the home page (Kp, Dst, AE, Ap). Indices are
/// fixed: they are edited and reordered, never created or deleted from the CMS.
///
/// `code` is the stable key: apps/web reads the card's label and tone from it
/// (`home.indicators.<code>`), and a future loading job upserts by it. `value`
/// is shared by every language ("-12 nT"); `description` is the Spanish text,
/// with the other languages in `GeomagneticIndexTranslation`. `position` is the
/// editorial display order: unique, written only by the reorder, and given the
/// next number of its sequence when a row is inserted without one, so a new
/// index lands last.
model GeomagneticIndex {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String                 @unique @db.VarChar(8)
  value       String                 @db.VarChar(15)
  description String                 @db.VarChar(15)
  position    Int                    @unique @default(autoincrement())
  source      GeomagneticIndexSource @default(MANUAL)
  /// When the value was observed. Null while values are entered by hand.
  observedAt  DateTime?              @map("observed_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  translations GeomagneticIndexTranslation[]

  @@map("geomagnetic_indices")
  @@schema("public")
}

