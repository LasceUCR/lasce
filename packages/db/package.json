{
  "name": "@lasce/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "clean": "rm -rf .turbo generated node_modules"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1"
  },
  "devDependencies": {
    "@lasce/config": "workspace:*",
    "@lasce/eslint-config": "workspace:*",
    "@types/node": "^22.15.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
