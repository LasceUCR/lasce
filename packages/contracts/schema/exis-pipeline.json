{
  "$id": "https://lasce.local/schema/jobs/exis-pipeline.json",
  "title": "exis-pipeline",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "enum": [
        "SFEU",
        "SFXR"
      ]
    },
    "spacecraft": {
      "default": 19,
      "anyOf": [
        {
          "type": "number",
          "const": 16
        },
        {
          "type": "number",
          "const": 17
        },
        {
          "type": "number",
          "const": 18
        },
        {
          "type": "number",
          "const": 19
        }
      ]
    },
    "lookbackDays": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 31
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    }
  },
  "required": [
    "product",
    "spacecraft",
    "lookbackDays"
  ],
  "additionalProperties": false
}
