{
  "$id": "https://lasce.local/schema/jobs/suvi-pipeline.json",
  "title": "suvi-pipeline",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "channel": {
      "type": "string",
      "enum": [
        "Fe093",
        "Fe131",
        "Fe171",
        "Fe195",
        "Fe284",
        "He303"
      ]
    },
    "spacecraft": {
      "default": 19,
      "anyOf": [
        {
          "type": "number",
          "const": 16
        },
        {
          "type": "number",
          "const": 17
        },
        {
          "type": "number",
          "const": 18
        },
        {
          "type": "number",
          "const": 19
        }
      ]
    },
    "lookbackMinutes": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    }
  },
  "required": [
    "channel",
    "spacecraft",
    "lookbackMinutes"
  ],
  "additionalProperties": false
}
