{
  "name": "@lasce/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:deps": "uv sync",
    "dev": "uv run python -m app.main",
    "start": "uv run python -m app.main",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "format": "uv run ruff format .",
    "typecheck": "uv run mypy app",
    "test": "uv run pytest",
    "clean": "rm -rf .turbo .venv .pytest_cache .ruff_cache .mypy_cache"
  }
}
