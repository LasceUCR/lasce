{
  "name": "Development",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/development"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "lint", "integration_id": 15368 },
          { "context": "typecheck", "integration_id": 15368 },
          { "context": "test", "integration_id": 15368 },
          { "context": "build", "integration_id": 15368 },
          { "context": "worker", "integration_id": 15368 },
          { "context": "e2e", "integration_id": 15368 },
          { "context": "docker (web)", "integration_id": 15368 },
          { "context": "docker (worker)", "integration_id": 15368 }
        ]
      }
    }
  ]
}
